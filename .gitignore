# Local development against a sibling ui-kit checkout. CI resolves slate_ui
# from the pinned git tag, which is what proves the dependency the release
# actually ships is the one that builds.
pubspec_overrides.yaml

# Generated localizations are committed on purpose: CI checks that they are not
# stale, which only works if the checked-in copy is the reference.

# Symbolication and obfuscation
app.*.symbols
app.*.map.json

# Packaging output
/build/dist/
/build/deb/
/build/AppDir/
/build/icons/

# A Windows runner is scaffolded locally so the interface can be looked at
# without a VM, and because building for a second platform catches things the
# Linux build hides — the missing-libmpv window bug was found that way. It is
# not a target: no MPRIS, no VA-API, no XDG, packaging ignores it and CI never
# builds it. Regenerate with `flutter create --platforms=windows .`, then
# `git checkout -- .metadata`, which deliberately lists linux alone.
windows/
